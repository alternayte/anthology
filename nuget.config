<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Deedbox is not on nuget.org yet. packages/ holds its pre-release packages; remove this source once 0.1.0 ships. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="deedbox-local" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="deedbox-local">
      <package pattern="Deedbox" />
      <package pattern="Deedbox.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
