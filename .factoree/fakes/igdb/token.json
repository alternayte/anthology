{
  "name": "IGDB OAuth token",
  "request": {
    "method": "POST",
    "urlPath": "/oauth2/token"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "local-fake-token",
      "expires_in": 3600,
      "token_type": "bearer"
    }
  }
}
