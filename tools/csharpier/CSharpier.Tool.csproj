<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>csharpier</ToolCommandName>
    <PackageId>csharpier</PackageId>
    <Version>1.3.0</Version>
    <AssemblyName>csharpier</AssemblyName>
    <Description>CSharpier 1.3.0 launcher for the checked-in local tool package.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None
      Update="csharpier.mjs"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
