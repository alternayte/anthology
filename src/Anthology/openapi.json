{
  "openapi": "3.1.1",
  "info": {
    "title": "Anthology | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/"
    }
  ],
  "paths": {
    "/api/identity/register": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/login": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/logout": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/identity/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/search": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "searchCatalog",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TitleSearchResult"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/titles": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "operationId": "addTitle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTitleCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TitleDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/titles/{titleId}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "getTitle",
        "parameters": [
          {
            "name": "titleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TitleDetailDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracking/items/{titleId}/want": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "operationId": "wantItem",
        "parameters": [
          {
            "name": "titleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackedItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracking/items/{titleId}/start": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "operationId": "startItem",
        "parameters": [
          {
            "name": "titleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackedItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracking/items/{titleId}/finish": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "operationId": "finishItem",
        "parameters": [
          {
            "name": "titleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackedItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracking/items/{titleId}/abandon": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "operationId": "abandonItem",
        "parameters": [
          {
            "name": "titleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackedItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracking/items/{titleId}/rerate": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "operationId": "rerateItem",
        "parameters": [
          {
            "name": "titleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackedItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracking/diary": {
      "get": {
        "tags": [
          "Tracking"
        ],
        "operationId": "getDiary",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOfDiaryEntryDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracking/library": {
      "get": {
        "tags": [
          "Tracking"
        ],
        "operationId": "getLibrary",
        "parameters": [
          {
            "name": "media",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minRating",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dir",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOfLibraryItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile/me": {
      "get": {
        "tags": [
          "Profile"
        ],
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "operationId": "updateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddTitleCommand": {
        "required": [
          "tmdbId"
        ],
        "type": "object",
        "properties": {
          "tmdbId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "AuthResponse": {
        "required": [
          "userId",
          "email"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "DiaryEntryDto": {
        "required": [
          "titleId",
          "status",
          "rating",
          "occurredAt"
        ],
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/TrackedStatus"
          },
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FinishRequest": {
        "required": [
          "rating"
        ],
        "type": "object",
        "properties": {
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "LibraryItemDto": {
        "required": [
          "titleId",
          "title",
          "mediaType",
          "status",
          "rating",
          "addedAt",
          "finishedAt"
        ],
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "mediaType": {
            "$ref": "#/components/schemas/MediaType"
          },
          "status": {
            "$ref": "#/components/schemas/TrackedStatus"
          },
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MediaType": {
        "enum": [
          "film"
        ]
      },
      "PageOfDiaryEntryDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiaryEntryDto"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PageOfLibraryItemDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LibraryItemDto"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProfileDto": {
        "required": [
          "userId",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "Rating": {
        "type": "object",
        "properties": {
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RerateRequest": {
        "required": [
          "rating"
        ],
        "type": "object",
        "properties": {
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "TitleDetailDto": {
        "required": [
          "titleId",
          "name",
          "year",
          "posterPath",
          "overview",
          "mediaType"
        ],
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "overview": {
            "type": [
              "null",
              "string"
            ]
          },
          "mediaType": {
            "$ref": "#/components/schemas/MediaType"
          }
        }
      },
      "TitleDto": {
        "required": [
          "titleId",
          "name",
          "year",
          "posterPath",
          "mediaType"
        ],
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "mediaType": {
            "$ref": "#/components/schemas/MediaType"
          }
        }
      },
      "TitleSearchResult": {
        "required": [
          "tmdbId",
          "name",
          "year",
          "posterPath",
          "overview"
        ],
        "type": "object",
        "properties": {
          "tmdbId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "overview": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TrackedItemDto": {
        "required": [
          "streamId",
          "titleId",
          "status",
          "rating"
        ],
        "type": "object",
        "properties": {
          "streamId": {
            "type": "string",
            "format": "uuid"
          },
          "titleId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/TrackedStatus"
          },
          "rating": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Rating"
              }
            ]
          }
        }
      },
      "TrackedStatus": {
        "enum": [
          "none",
          "want_to_consume",
          "in_progress",
          "finished",
          "abandoned",
          "rerated"
        ]
      },
      "UpdateProfileCommand": {
        "required": [
          "displayName"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Identity"
    },
    {
      "name": "Catalog"
    },
    {
      "name": "Tracking"
    },
    {
      "name": "Profile"
    }
  ]
}